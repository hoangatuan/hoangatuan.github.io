---
import checkmark from '/src/assets/common/checkmark.png';
import loading from '/src/assets/common/loading.png';
---

  <form id="article-subscribe-form" class="bg-accent px-6 py-1 rounded-lg shadow-md max-w-2xl mx-auto">
    <h2 class="text-2xl font-bold text-center text-white">Subscribe to my space</h2>
    <p class="text-center text-white">Stay updated on new articles and book reviews about Swift, iOS, and software engineering.</p>
  
    <div class="flex justify-center items-center space-x-2 h-10">
      <input
        id="article-email-address"
        name="email"
        type="email"
        autocomplete="email"
        required
        class="email min-w-0 flex-auto rounded-md bg-white px-3.5 py-2 text-base text-black border border-gray-300 outline-none placeholder:text-gray-500 sm:text-sm h-full"
        placeholder="Your email address..."
      />

      <button id="article-subscribe-button" type="submit" class="bg-CEA4D21 rounded-md text-white px-4 h-full fixed-width text-sm flex items-center justify-center relative">
        <span id="article-button-text">Subscribe</span>
        <img id="article-loading-icon" src={loading.src} class="hidden w-5 h-5 filter-white animate-spin" alt="Loading"/>
        <img id="article-checkmark-icon" src={checkmark.src} class="hidden w-5 h-5 filter-white" alt="Checkmark"/>
      </button>
    </div>
  
    <p id="article-confirmation-message" class="text-center text-stone-100 text-sm mt-4 hidden">I've sent you a confirmation email! Please check your email to confirm your subscription.</p>
    <p class="text-center text-gray-300 text-sm mt-4">100% free. Unsubscribe at any time.</p>
  </form>

  <style>
    .filter-white {
      filter: invert(1) brightness(2);
    }
  
    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
  
    .animate-spin {
      animation: spin 1s linear infinite;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("article-subscribe-form");
      const confirmationMessage = document.getElementById("article-confirmation-message");

      const buttonText = document.getElementById('article-button-text');
      const loadingIcon = document.getElementById('article-loading-icon');
      const checkmarkIcon = document.getElementById('article-checkmark-icon');
  
      form?.addEventListener("submit", async (event) => {
        event.preventDefault(); // Prevent the form from submitting the traditional way

        buttonText?.classList.add('hidden');
        loadingIcon?.classList.remove('hidden');
        checkmarkIcon?.classList.add('hidden');
        confirmationMessage?.classList.add("hidden");
        
        const emailInput = document.getElementById("article-email-address") as HTMLInputElement;
        const value = emailInput.value;
  
        try {
          const res = await fetch("/api/subscribe.json", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ email: value }),
          });
  
          if (!res.ok) {
            throw new Error("Something went wrong");
          }
  
          // const resData = await res.json();
          confirmationMessage?.classList.remove("hidden");
          checkmarkIcon?.classList.remove('hidden');
          loadingIcon?.classList.add('hidden');
  
        } catch (error) {
          console.error(error);
          confirmationMessage?.classList.add("hidden");
          checkmarkIcon?.classList.add('hidden');
          loadingIcon?.classList.add('hidden');
          buttonText?.classList.remove('hidden');
          alert("Failed to submit email");
        }
      });
    });
  </script>


<style>
  .fixed-width {
    width: 120px;
  }
  .hidden {
    display: none;
  }
</style>