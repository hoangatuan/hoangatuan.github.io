---
import { getPermalink } from '../../utils/permalinks';
import { APP_BLOG } from '../../utils/config';

export interface Props {
  tags?: Array<string>;
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = '', title = undefined, isCategory = false } = Astro.props;
---

{
  tags && Array.isArray(tags) && (
    <>
      {title !== undefined && (
        <span class="align-super font-normal underline underline-offset-4 decoration-2 dark:text-slate-400">
          {title}
        </span>
      )}
      <ul class:list={['flex flex-wrap justify-start gap-1.5 text-left', className]}>
        {tags.map((tag) => (
          <li class="inline-flex rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium lowercase transition-colors hover:bg-zinc-200">
            {!APP_BLOG?.tag?.isEnabled ? (
              tag
            ) : (
              <a
                href={getPermalink(tag, isCategory ? 'category' : 'tag')}
                class="text-zinc-600 hover:text-primary"
              >
                #{tag}
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}
