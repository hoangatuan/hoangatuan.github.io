---
import BookItem from './BookItem.astro';
import type { Book } from '../../types/books.types';

export interface Props {
  prefix: string;
  books: Array<Book>;
}

const { prefix, books } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <header class="mb-8 border-b border-zinc-200 pb-6">
    <h1 class="font-heading text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl">Book reviews</h1>
    <p class="mt-2 text-base text-zinc-600">Short reviews of books that shaped how I think about engineering.</p>
  </header>

  <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {
      books.map((book) => (
        <li class="flex min-w-0">
          <BookItem prefix={prefix} book={book} />
        </li>
      ))
    }
  </ul>
</section>
