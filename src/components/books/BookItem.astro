---
import type { Book } from '../../types/books.types';
import { Icon } from 'astro-icon/components';
import { getFormattedDate } from '../../utils/utils';
import PostTags from '../common/Tags.astro';
import { getPermalink } from '../../utils/permalinks';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  prefix: string;
  book: Book;
}

const { prefix, book } = Astro.props;
const imagePath = book.cover;
const link = getPermalink(book.permalink, 'book');
const href = `/${prefix}${link}`;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/content/book/*/*.{jpeg,jpg,png,gif}');
if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/assets/content/book/*/*.{jpeg,jpg,png,gif}"`);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-zinc-200 bg-white p-5 text-left shadow-sm transition-colors duration-200 hover:border-zinc-300">
  <a
    href={href}
    class="absolute inset-0 z-0 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    aria-label={`Read book review: ${book.title}`}
  />

  <div class="relative z-10 flex h-full flex-col pointer-events-none">
    <div class="mb-4 flex h-36 shrink-0 items-center justify-center overflow-hidden rounded-md bg-zinc-50">
      <Image class="max-h-full w-auto object-contain" src={images[imagePath]()} alt={book.title} />
    </div>

    <h2 class="mb-2 min-h-[3.25rem] text-lg font-semibold leading-snug text-zinc-900 transition-colors duration-200 group-hover:text-primary [display:-webkit-box] [-webkit-line-clamp:2] [-webkit-box-orient:vertical] overflow-hidden">
      {book.title}
    </h2>

    <p class="mb-4 min-h-[2.75rem] flex-1 text-sm leading-relaxed text-zinc-600 [display:-webkit-box] [-webkit-line-clamp:2] [-webkit-box-orient:vertical] overflow-hidden">
      {book.excerpt}
    </p>

    <div class="mt-auto flex items-center justify-between gap-2 text-xs text-zinc-500">
      <div class="min-w-0 flex-1 text-left pointer-events-auto">
        <PostTags tags={book.categories} />
      </div>
      <span class="inline-flex shrink-0 items-center">
        <Icon name="tabler:clock" class="-mt-0.5 mr-1 inline-block h-3.5 w-3.5" />
        <time datetime={String(book.publishDate)}>{getFormattedDate(book.publishDate)}</time>
      </span>
    </div>
  </div>
</article>
