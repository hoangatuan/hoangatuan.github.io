---
import type { Post } from '../../types/post.types';
import Item from './ListItem.astro';
import { fetchRelatedPosts } from '../../utils/blog';

export interface Props {
  prefix: string;
  post: Post;
}

const { prefix, post } = Astro.props;

const posts = await fetchRelatedPosts(post);
---

<div class="mx-auto max-w-5xl px-4 lg:px-8">
  <ul class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
    {
      posts.map((relatedPost) => (
        <li class="flex min-w-0">
          <Item prefix={prefix} post={relatedPost} />
        </li>
      ))
    }
  </ul>
</div>
