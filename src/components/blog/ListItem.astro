---
import type { Post } from '../../types/post.types';
import PostTags from '../common/Tags.astro';
import { getFormattedDate } from '../../utils/utils';
import { getPermalink } from '../../utils/permalinks';

export interface Props {
  prefix: string;
  post: Post;
}

const { prefix, post } = Astro.props;
const link = getPermalink(post.permalink, 'post');
const href = `/${prefix}${link}`;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-zinc-200 bg-white p-5 text-left shadow-sm transition-colors duration-200 hover:border-zinc-300">
  <a
    href={href}
    class="absolute inset-0 z-0 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    aria-label={`Read article: ${post.title}`}
  />

  <div class="relative z-10 flex h-full flex-col pointer-events-none">
    <div class="mb-3 flex items-start justify-between gap-3 text-left">
      <div class="min-w-0 flex-1 pointer-events-auto">
        <PostTags tags={post.tags} />
      </div>
      <time datetime={String(post.publishDate)} class="shrink-0 pt-0.5 text-xs text-zinc-500">{getFormattedDate(post.publishDate)}</time>
    </div>

    <h2 class="mb-2 min-h-[3.25rem] text-lg font-semibold leading-snug text-zinc-900 transition-colors duration-200 group-hover:text-primary [display:-webkit-box] [-webkit-line-clamp:2] [-webkit-box-orient:vertical] overflow-hidden">
      {post.title}
    </h2>

    <p class="mb-4 min-h-[4.125rem] flex-1 text-sm leading-relaxed text-zinc-600 [display:-webkit-box] [-webkit-line-clamp:3] [-webkit-box-orient:vertical] overflow-hidden">
      {post.excerpt}
    </p>

    <span class="mt-auto inline-flex items-center text-sm font-medium text-primary group-hover:underline">
      Read more
      <svg class="ml-1.5 h-4 w-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
    </span>
  </div>
</article>
