---
import type { Post } from '../../types/post.types';
import PostTags from '../common/Tags.astro';
import { getFormattedDate } from '../../utils/utils';
import { getPermalink } from '../../utils/permalinks';

export interface Props {
  prefix: string;
  post: Post;
  isLast: boolean;
}

const { prefix, post, isLast } = Astro.props;
const link = getPermalink(post.permalink, 'post');
---

<article class="group py-6">
  <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-zinc-500">
    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
    <PostTags tags={post.tags} />
  </div>

  <h2 class="mb-2 text-xl font-semibold leading-snug text-zinc-900 transition-colors duration-200 group-hover:text-primary sm:text-2xl">
    <a href={`/${prefix}${link}`} class="cursor-pointer">
      {post.title}
    </a>
  </h2>

  <p class="max-w-3xl text-base leading-relaxed text-zinc-600">
    <a href={`/${prefix}${link}`} class="cursor-pointer hover:text-zinc-800">
      {post.excerpt}
    </a>
  </p>

  {
    !isLast && (
      <div class="mt-6 border-b border-zinc-200" />
    )
  }
</article>
