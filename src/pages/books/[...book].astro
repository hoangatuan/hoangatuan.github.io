---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ContentDetailLayout from '../../layouts/ContentDetailLayout.astro';
import { getStaticPathsBook } from '../../utils/book';
import '../../styles/global.css';

export const getStaticPaths = (async () => {
  return await getStaticPathsBook();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { book } = Astro.props as Props;
const { Content } = book;
---

<PageLayout title={book.title} description={book.excerpt} type="article" publishedTime={book.publishDate.toISOString()}>
  <ContentDetailLayout
    title={book.title}
    publishDate={book.publishDate}
    excerpt={book.excerpt}
    image={book.image}
    headings={book.headings}
    tags={book.categories}
    readingTime={book.readingTime}
    shareTitle={book.title}
    shareDescription={book.excerpt || book.title}
  >
    {Content ? <Content /> : <Fragment set:html={book.content || ''} />}
  </ContentDetailLayout>
</PageLayout>
