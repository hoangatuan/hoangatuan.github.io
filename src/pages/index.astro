---
import PageLayout from '../layouts/PageLayout.astro';
import LatestArticles from '../components/home/LatestArticles.astro';
import LatestBooks from '../components/home/LatestBooks.astro';
import IntroduceCard from '../components/home/IntroduceCard.astro';
import Subscription from '../components/home/HomeSubscriptionCard.astro';
---

<PageLayout title="Eric's Space">
  <IntroduceCard />

  <Subscription />

  <section class="mx-auto max-w-6xl px-4 pb-16 pt-12 text-left sm:px-6">
    <header class="mb-8 text-center">
      <h2 class="font-heading text-3xl font-semibold tracking-tight text-zinc-900 lg:text-4xl">Latest articles</h2>
    </header>

    <LatestArticles />

    <div class="mt-10 flex justify-center">
      <a
        href="/articles"
        class="inline-flex cursor-pointer items-center justify-center rounded-full border border-zinc-300 px-7 py-3.5 font-semibold text-zinc-900 shadow-sm transition-colors duration-200 hover:border-zinc-400 hover:bg-zinc-100"
      >
        View All
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 text-left sm:px-6">
    <header class="mb-8 text-center">
      <h2 class="font-heading text-3xl font-semibold tracking-tight text-zinc-900 lg:text-4xl">Latest book reviews</h2>
    </header>

    <LatestBooks />

    <div class="mt-10 flex justify-center">
      <a
        href="/books"
        class="inline-flex cursor-pointer items-center justify-center rounded-full border border-zinc-300 px-7 py-3.5 font-semibold text-zinc-900 shadow-sm transition-colors duration-200 hover:border-zinc-400 hover:bg-zinc-100"
      >
        View All
      </a>
    </div>
  </section>
</PageLayout>
